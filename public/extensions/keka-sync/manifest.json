{
  "manifest_version": 3,
  "name": "Go Home Early",
  "version": "1.0",

  "permissions": ["storage"],

  "host_permissions": ["*://*.keka.com/*"],

  "action": {
    "default_popup": "popup.html"
  },
"icons": {
   "128": "icon128.png"
},
  "content_scripts": [
    {
      "matches": ["*://*.keka.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}